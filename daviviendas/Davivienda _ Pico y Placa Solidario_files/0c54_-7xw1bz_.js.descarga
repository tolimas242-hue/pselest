        .oval-container {
          position: relative;
          width: 220px;
          height: 285px;
          margin: 0 auto;
          border-radius: 50% / 45%;
          overflow: hidden;
          border: 4px solid white;
          background-color: #000;
        }

        .bancolombia-loader {
          width: 40px;
          height: 40px;
          border: 4px solid rgba(255, 255, 255, 0.2);
          border-top: 4px solid #FDDA24;
          border-radius: 50%;
          animation: spin 1s linear infinite;
